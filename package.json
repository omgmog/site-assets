{
  "name": "omgmog-assets",
  "private": true,
  "type": "module",
  "scripts": {
    "build:css": "postcss \"src/css/*.css\" --base src/css --dir css",
    "build:js": "esbuild src/js/main.ts --bundle --minify --outfile=js/main.js",
    "optimize:images": "node scripts/optimize-images.js",
    "build": "npm run build:css && npm run build:js && npm run optimize:images"
  },
  "devDependencies": {
    "cssnano": "^9.0.5",
    "esbuild": "^0.28.2",
    "glob": "^13.0.6",
    "postcss": "^8.5.28",
    "postcss-cli": "^12.0.0",
    "postcss-import": "^17.0.0",
    "postcss-preset-env": "^11.5.4",
    "sharp": "^0.35.4",
    "svgo": "^4.1.0"
  }
}
